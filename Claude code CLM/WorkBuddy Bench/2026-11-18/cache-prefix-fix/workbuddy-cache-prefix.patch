+def _deepseek_system(system):
+    if isinstance(system, str):
+        return _strip_claude_billing_line(system)
+    if isinstance(system, list) and system:
+        first = system[0]
+        if isinstance(first, dict) and first.get('type') == 'text' and isinstance(first.get('text'), str):
+            text = _strip_claude_billing_line(first['text'])
+            if text != first['text']:
+                return [{**first, 'text': text}, *system[1:]] if text else system[1:]
+    return system
 
 
